# Copy to .env.local and fill in from:
# Firebase console -> Project settings -> General -> Your apps -> Web app (SDK config)
# https://console.firebase.google.com/u/2/project/dunbarscircles/settings/general
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dunbarscircles.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=dunbarscircles
VITE_FIREBASE_STORAGE_BUCKET=dunbarscircles.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
